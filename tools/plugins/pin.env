# Pins for the Charred Horizons Android plugins (android_plugins/, built by tools/plugins/build_plugins.sh).
# Read by bash (source) and by the Gradle build (java.util.Properties), so: plain KEY=VALUE, no inline comments,
# no quotes, no spaces around "=".
#
# Toolchain: the same Gradle, Android Gradle Plugin and Kotlin that Godot 4.7.2's own Android build template uses
# (game/android/build/config.gradle), so the plugin AARs and the game's Gradle build share one download cache.
# Gradle itself is pinned (version + SHA-256) in android_plugins/gradle/wrapper/gradle-wrapper.properties.
ANDROID_PLUGINS_VERSION=0.1.0
GODOT_LIB_VERSION=4.7.2.stable
AGP_VERSION=8.6.1
KOTLIN_VERSION=2.1.21
FRAGMENT_VERSION=1.8.6
# Compile-time only (OnNewIntentProvider, Consumer); the game's own Gradle build supplies the runtime copy.
CORE_VERSION=1.13.1
#
# Firebase Cloud Messaging (push). FIREBASE_BOM_VERSION is the Bill of Materials the plugin is compiled against.
# Godot adds Maven dependencies as plain "group:artifact:version" strings (no BOM support), so the version the BOM
# resolves to is pinned explicitly below and the Gradle build FAILS if the two ever disagree.
# Only built into an app when android_plugins/google-services.json exists (see docs/FIREBASE_SETUP.md).
FIREBASE_BOM_VERSION=34.19.0
FIREBASE_MESSAGING_VERSION=25.1.3
#
# Sign in with Google (Credential Manager).
CREDENTIALS_VERSION=1.6.0
GOOGLEID_VERSION=1.1.1
