# Pinned Google Play Billing plugin (godot-sdk-integrations/godot-google-play-billing).
# Sourced by tools/setup_billing_plugin.sh and read by .github/workflows/mirror-plugins.yml. Plain KEY=VALUE only.
#
# 3.3.0 = newest tag at the time of pinning (Play Billing Library 9.1.0). Godot 4.2+, Android plugin v2 format
# (an EditorExportPlugin that returns the AAR and the Maven dependency; no manual AndroidManifest or gradle edits).
# The upstream project publishes no checksums for its release assets, so we build the AARs from the exact commit and
# pin the SHA-256 of every vendored file in tools/billing/SHA256SUMS (the build is reproducible: same hashes twice).
BILLING_PLUGIN_VERSION=3.3.0
BILLING_PLUGIN_REPO=https://github.com/godot-sdk-integrations/godot-google-play-billing.git
BILLING_PLUGIN_COMMIT=e494f370ee591fa11823ad2749a070ed1149de99
# Gradle wrapper, AGP 8.13.2, Kotlin 2.2.21 and billing-ktx 9.1.0 are pinned by the upstream repo itself.
