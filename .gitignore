# Godot 4
.godot/
/game/android/

# Export outputs
*.apk
*.aab

# Signing material: never commit (CI reads these from GitHub Actions secrets)
*.keystore
*.jks
# Exception: the public, debug-only keystore (see tools/android/README.md). Nothing else.
!/tools/android/debug.keystore

# OS
.DS_Store

# Build output
/build/

# Python bytecode
__pycache__/
*.pyc

# Node / Firebase (firebase/ and firebase/functions/)
node_modules/
/firebase/functions/lib/
/firebase/.firebase/
*-debug.log
/firebase/functions/.secret.local
/firebase/functions/.env.local
/firebase/functions/.runtimeconfig.json
/firebase/*.local

# Firebase / Google service credentials: never commit
google-services.json
service-account*.json
